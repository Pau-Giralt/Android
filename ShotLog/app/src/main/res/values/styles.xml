<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Botones ===== -->

    <!-- Botón principal: pastilla verde oscuro -->
    <style name="Widget.ShotLog.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/beige</item>
        <item name="backgroundTint">@color/verde_oscuro</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <!-- Botón secundario: pastilla con borde -->
    <style name="Widget.ShotLog.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="strokeColor">@color/verde_oscuro</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">30dp</item>
    </style>

    <!-- Botón para acciones peligrosas (eliminar) -->
    <style name="Widget.ShotLog.Button.Peligro" parent="Widget.ShotLog.Button.Outlined">
        <item name="android:textColor">@color/rojo_error</item>
        <item name="strokeColor">@color/rojo_error</item>
        <item name="iconTint">@color/rojo_error</item>
    </style>

    <!-- Botón de texto (Saltar) -->
    <style name="Widget.ShotLog.Button.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">60dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gris_calido</item>
    </style>

    <!-- Botones de las opciones de Preferencias -->
    <style name="Widget.ShotLog.Button.Opcion" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="strokeColor">@color/gris_calido</item>
    </style>

    <!-- ===== Campos de texto ===== -->

    <style name="Widget.ShotLog.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxStrokeColor">@color/verde_oscuro</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="endIconTint">@color/gris_calido</item>
        <item name="startIconTint">@color/gris_calido</item>
    </style>

    <style name="Widget.ShotLog.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/negro</item>
        <item name="android:textColorHint">@color/gris_calido</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ===== Textos ===== -->

    <style name="TextAppearance.ShotLog.Logo" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/verde_oscuro</item>
    </style>

    <style name="TextAppearance.ShotLog.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/verde_oscuro</item>
    </style>

    <style name="TextAppearance.ShotLog.TituloBarra" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/verde_oscuro</item>
    </style>

    <style name="TextAppearance.ShotLog.Seccion" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/negro</item>
    </style>

    <style name="TextAppearance.ShotLog.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/gris_calido</item>
    </style>

    <!-- Texto pulsable (enlaces tipo "¿No tienes cuenta?") -->
    <style name="Widget.ShotLog.Enlace" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/verde_oscuro</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Barra superior de las pantallas secundarias -->
    <style name="Widget.ShotLog.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/beige</item>
        <item name="navigationIcon">@drawable/ic_flecha_atras</item>
        <item name="navigationContentDescription">@string/volver</item>
        <item name="titleTextAppearance">@style/TextAppearance.ShotLog.TituloBarra</item>
    </style>

    <!-- Tarjetas -->
    <style name="Widget.ShotLog.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/beige_claro</item>
        <item name="strokeColor">@color/beige_oscuro</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Chips de filtro -->
    <style name="Widget.ShotLog.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/negro</item>
        <item name="chipStrokeColor">@color/beige_oscuro</item>
        <item name="chipBackgroundColor">@color/chip_fondo</item>
    </style>
</resources>
