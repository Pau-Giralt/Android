<?xml version="1.0" encoding="utf-8"?>
<!-- Registro de tiros, estilo blanco electrónico SIUS: fondo oscuro, diana grande y panel de datos -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sius_fondo"
    tools:context=".RegistroTirosActivity">

    <!-- Volver, modalidad · modo y la flecha de deshacer -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sius_fondo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_registro"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_flecha_atras"
        app:navigationIconTint="@color/sius_texto"
        app:titleTextColor="@color/sius_texto"
        tools:title="Pistola · Entrenamiento" />

    <!-- Diana cuadrada lo más grande posible -->
    <FrameLayout
        android:id="@+id/marcoDiana"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/panelDatos"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintVertical_bias="0">

        <com.example.shotlog.ui.DianaView
            android:id="@+id/diana"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/fondo_chip_sius"
            android:importantForAccessibility="no"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/sius_texto"
            android:textSize="13sp"
            tools:text="Zoom 1/3 · Toca la diana para ampliar" />

        <TextView
            android:id="@+id/tvAvisoRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/fondo_aviso_registro"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/aviso_registro"
            android:textColor="@color/negro_fijo"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Panel de datos -->
    <LinearLayout
        android:id="@+id/panelDatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/filaBotones"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/datoDisparo"
                layout="@layout/vista_dato_sius"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/datoUltimo"
                layout="@layout/vista_dato_sius"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/datoSerie"
                layout="@layout/vista_dato_sius"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_dato_sius"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvEtiquetaTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.ShotLog.SiusEtiqueta"
                tools:text="Total · 14 disparos" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/sius_texto"
                android:textSize="36sp"
                tools:text="132" />
        </LinearLayout>

        <!-- Puntos de cada serie (solo en competición) -->
        <HorizontalScrollView
            android:id="@+id/scrollSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/contenedorSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Botones grandes -->
    <LinearLayout
        android:id="@+id/filaBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizar"
            style="@style/Widget.ShotLog.Button.SiusSecundario"
            android:layout_width="wrap_content"
            android:layout_height="68dp"
            android:layout_marginEnd="8dp"
            android:text="@string/finalizar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrar"
            style="@style/Widget.ShotLog.Button.Sius"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/registrar_tiro"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
