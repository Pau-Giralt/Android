<?xml version="1.0" encoding="utf-8"?>
<!-- INICIO: DrawerLayout = contenido + menú lateral que sale desde la izquierda -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenido de la pantalla -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/beige"
        android:orientation="vertical">

        <!-- ☰ a la izquierda, título y ⚙ a la derecha (menu_ajustes) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.ShotLog.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_ajustes"
            app:navigationContentDescription="@string/abrir_menu"
            app:navigationIcon="@drawable/ic_menu"
            app:title="@string/app_name" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/inicio_saludo"
                    android:textAppearance="@style/TextAppearance.ShotLog.Titulo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/inicio_pregunta"
                    android:textAppearance="@style/TextAppearance.ShotLog.Cuerpo" />

                <!-- Acciones principales -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevoEntrenamiento"
                    style="@style/Widget.ShotLog.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/nuevo_entrenamiento"
                    app:icon="@drawable/ic_anadir"
                    app:iconGravity="textStart"
                    app:iconTint="@color/beige" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNuevaCompeticion"
                    style="@style/Widget.ShotLog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nueva_competicion"
                    app:icon="@drawable/ic_trofeo"
                    app:iconGravity="textStart"
                    app:iconTint="@color/verde_oscuro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMisEntrenos"
                    style="@style/Widget.ShotLog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/mis_entrenos"
                    app:icon="@drawable/ic_lista"
                    app:iconGravity="textStart"
                    app:iconTint="@color/verde_oscuro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuia"
                    style="@style/Widget.ShotLog.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/guia_inicio"
                    app:icon="@drawable/ic_ayuda"
                    app:iconGravity="textStart"
                    app:iconTint="@color/verde_oscuro" />

                <!-- Última sesión (al tocarla se abre su detalle) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ultima_sesion"
                    android:textAppearance="@style/TextAppearance.ShotLog.Seccion" />

                <include
                    android:id="@+id/ultimaSesion"
                    layout="@layout/item_sesion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Menú lateral (☰) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/beige"
        app:headerLayout="@layout/nav_cabecera"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>
