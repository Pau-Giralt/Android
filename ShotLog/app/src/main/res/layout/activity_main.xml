<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla inicial TEMPORAL con botones para navegar (actividad 05).
     Usa ConstraintLayout con una cadena vertical (chain) de botones. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <!-- Botón ? arriba a la derecha: abre la guía -->
        <ImageButton
            android:id="@+id/btnAyuda"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ver_guia"
            android:src="@drawable/ic_ayuda"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/logo_descripcion"
            android:src="@drawable/ic_diana"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAyuda" />

        <TextView
            android:id="@+id/tvNombreApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.ShotLog.Logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pantallas_titulo"
            android:textAppearance="@style/TextAppearance.ShotLog.Cuerpo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreApp" />

        <!-- Cadena vertical de botones (chainStyle packed) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrLogin"
            style="@style/Widget.ShotLog.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ir_login"
            app:layout_constraintBottom_toTopOf="@id/btnIrRegistro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrRegistro"
            style="@style/Widget.ShotLog.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ir_registro"
            app:layout_constraintBottom_toTopOf="@id/btnIrGuia"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrLogin" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrGuia"
            style="@style/Widget.ShotLog.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ir_guia"
            app:layout_constraintBottom_toTopOf="@id/btnIrPreferencias"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrRegistro" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrPreferencias"
            style="@style/Widget.ShotLog.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ir_preferencias"
            app:layout_constraintBottom_toTopOf="@id/btnIrSesiones"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrGuia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrSesiones"
            style="@style/Widget.ShotLog.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ir_sesiones"
            app:layout_constraintBottom_toTopOf="@id/btnIrEditar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrPreferencias" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrEditar"
            style="@style/Widget.ShotLog.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ir_editar"
            app:layout_constraintBottom_toTopOf="@id/tvNota"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrSesiones" />

        <TextView
            android:id="@+id/tvNota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/pantallas_nota"
            android:textColor="@color/gris_calido"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnIrEditar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
