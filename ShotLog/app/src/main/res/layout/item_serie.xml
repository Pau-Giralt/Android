<?xml version="1.0" encoding="utf-8"?>
<!-- Un elemento de la lista de series: mini diana con los impactos y la puntuación -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/fondo_etiqueta"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <com.example.shotlog.ui.DianaView
        android:id="@+id/dianaSerie"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvNumSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:textColor="@color/negro"
        android:textSize="13sp"
        tools:text="Serie 1" />

    <TextView
        android:id="@+id/tvPuntosSerie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"
        android:textColor="@color/verde_oscuro"
        android:textSize="16sp"
        tools:text="94" />
</LinearLayout>
