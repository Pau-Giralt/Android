<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShotLog">

        <!-- Primera pantalla al abrir la app -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Inicio (con menú lateral y ajustes) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GuiaActivity"
            android:exported="false" />
        <activity
            android:name=".NuevaSesionActivity"
            android:exported="false" />
        <activity
            android:name=".SesionesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DetalleSesionActivity"
            android:exported="false" />
        <activity
            android:name=".EditarSesionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CuentaActivity"
            android:exported="false" />
        <activity
            android:name=".PreferenciasActivity"
            android:exported="false" />
    </application>

</manifest>
